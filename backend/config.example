# Nekibuki Backend Environment Configuration

# Required: Google AI API Key for Gemini 2.0 Flash
# Get your API key from: https://aistudio.google.com/
export GOOGLE_API_KEY="your-google-ai-api-key-here"

# Optional: Server port (defaults to 8080)
export PORT="8080"

# To use this file:
# 1. Copy this file: cp config.example config
# 2. Edit config with your actual API key
# 3. Source it: source config
# 4. Run the server: go run cmd/server/main.go 