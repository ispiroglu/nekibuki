{
  "name": "nekibuki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"bun --bun vite\" \"wrangler dev --port 8787\"",
    "dev:web": "bun --bun vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "bun run typecheck && bun --bun vite build",
    "build:only": "bun --bun vite build",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json",
    "icons": "bun scripts/generate-icons.mjs",
    "shots": "bun scripts/screenshot.mjs",
    "brand:shots": "bun scripts/brand-shots.mjs",
    "smoke": "bun scripts/smoke.mjs",
    "perf": "bun scripts/perf-check.mjs",
    "types": "wrangler types",
    "db:migration": "echo 'Run supabase/migrations/0001_init.sql in the Supabase SQL editor'"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.2.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "idb": "^8.0.3",
    "lucide-react": "^1.59.0",
    "motion": "^14.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "playwright-core": "^1.64.1",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.42.0"
  }
}
