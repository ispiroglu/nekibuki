# Supabase (client, public values)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "mock" (local demo, no Google needed) or "supabase"
VITE_AUTH_MODE=mock

# Force the client-side mock analyzer even if the Worker is unreachable
VITE_MOCK_ANALYSIS=true

# UI language for the generated guide: en | tr
VITE_DEFAULT_LANGUAGE=en
