# "mock" (local demo, no Google needed) or "google" (Better Auth on the Worker)
VITE_AUTH_MODE=mock

# Force the client-side mock analyzer when the Worker is unreachable.
# Local UI previews only — ignored in production builds.
# VITE_MOCK_ANALYSIS=true

# UI language for the generated guide: en | tr
VITE_DEFAULT_LANGUAGE=en
