{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nekibuki-backend-hono",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "sessions_namespace"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "photos"
    }
  ],
  // "d1_databases": [
