{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "shared"],
  // Supabase was replaced by Better Auth; these two modules are unreferenced
  // and their dependency is no longer installed. Kept out of typecheck so the
  // app build reflects the code that actually ships.
  "exclude": ["src/lib/supabase.ts", "src/lib/repo/supabase.ts"]
}
